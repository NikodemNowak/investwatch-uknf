# Copy to .env and adjust (`cp .env.example .env`). Never commit .env.
# docker-compose.yml loads only .env (required); this file is a template, never loaded.
# Required: POSTGRES_PASSWORD and MINIO_ROOT_PASSWORD (compose refuses to start without them).
# Change both before exposing the stack beyond localhost.

# --- app
APP_DATA_DIR=/app/data
APP_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080,http://localhost:8000,http://localhost:5173

# --- postgres (pgvector)
POSTGRES_USER=investwatch
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=investwatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- redis (Celery broker + Socket.IO bus)
REDIS_URL=redis://redis:6379/0

# --- minio (S3 object storage). MinIO no longer publishes images on Docker Hub/Quay.
# Pinned by digest (Chainguard publishes only `latest`); bump after a Trivy scan.
MINIO_IMAGE=cgr.dev/chainguard/minio:latest@sha256:e9cf6b99c226e9539ed0f14b6f00e37b07da153c7ba1f4f8709c807574b471ec
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=investwatch
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=investwatch

# --- AI service and models
AI_URL=http://ai:8001
# llm = rules now, model second opinion later from the `llm` queue (default);
# rules = deterministic, no LLM; mock = the backend skips the ai service (keyword stand-in).
AI_MODE=llm
OLLAMA_URL=http://ollama:11434
# CPU default (pulled by ollama-init, 4.3 GB). docker-compose.gpu.yml switches to GPU_LLM_MODEL.
LLM_MODEL=gemma4:e2b-it-qat
GPU_LLM_MODEL=gemma3:12b
EMBED_MODEL=bge-m3
# false = never call Ollama for embeddings (docker-compose.lite.yml sets it with AI_MODE=rules).
EMBED_ENABLED=true

# --- collectors (ADR 0008: official APIs, imports and an honest crawler only)
# The crawler always identifies itself as InvestWatchBot/<ver> (+COLLECTOR_CONTACT_URL) and
# always obeys robots.txt, Crawl-delay and TDM reservations; there is no switch to turn that off.
COLLECTOR_CONTACT_URL=https://github.com/NikodemNowak/investwatch-uknf
COLLECTOR_CONTACT_EMAIL=
# Optional User-Agent pool separated by "|"; every entry MUST contain "InvestWatchBot"
# (startup fails otherwise). Empty = the two default InvestWatchBot agents. Rotation spreads
# load across honest agents; it is never used to hide the bot or to retry a refusal.
COLLECTOR_USER_AGENTS=
# Egress proxies (comma-separated, round-robin), e.g. the office's audited outbound proxy.
# The per-domain limit and the cooldown apply whatever proxy is used.
COLLECTOR_PROXY_URLS=
COLLECTOR_MIN_INTERVAL_S=2
# After a 401/403/429 or a bot challenge the domain is left alone this long (or Retry-After).
COLLECTOR_COOLDOWN_S=3600
COLLECTOR_TIMEOUT_S=20
# Private hosts that "check URL" may fetch (SSRF guard).
CHECK_ALLOWED_INTERNAL_HOSTS=demo-sites
# Items per run for youtube / meta_ad_library / tiktok / site sources (target may say `N:`).
PLATFORM_MAX_ITEMS=5
# URL fragments that make a sitemap URL worth checking (`site` collector).
SITE_URL_KEYWORDS=promocj,oferta,konto,bonus,kampani,inwest,kod,polec,partner,rachunek,lokat,fundusz
# The seed service adds the curated live sources (data/seeds/sources.yaml).
SEED_LIVE_SOURCES=true

# YouTube Data API v3 key: Google Cloud console -> new project -> enable "YouTube Data API v3"
# -> Credentials -> API key, restricted to that API. Free, 10,000 units/day; a few minutes.
# Empty = the youtube connector shows "wymaga klucza" and does not run.
YOUTUBE_API_KEY=
# Hard stop below Google's quota (search = 100 units, videos/channels = 1).
YOUTUBE_DAILY_UNITS=9000

# Meta Ad Library API token: confirm your identity at facebook.com/ID, create an app at
# developers.facebook.com, generate a user access token (expires after ~60 days).
# Identity check takes from hours to days. Empty = "wymaga klucza"; the Ad Library web page
# is never scraped. Without a token: import an Ad Library export (POST /api/imports).
META_AD_LIBRARY_TOKEN=
META_GRAPH_VERSION=v25.0
META_AD_LIBRARY_COUNTRY=PL
# ALL or FINANCIAL_PRODUCTS_AND_SERVICES_ADS
META_AD_TYPE=ALL

# TikTok Commercial Content API: TikTok for Developers account (work e-mail) -> apply for the
# Commercial Content API -> client key and secret of the approved app (about 2 working days).
# Empty = "wymaga zgody platformy"; TikTok pages are never scraped.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional open datasets for URL discovery (cached, failures never fail a run).
COMMONCRAWL_ENABLED=true
# Empty = newest crawl from index.commoncrawl.org/collinfo.json
COMMONCRAWL_INDEX=
# GDELT news (1 query / 5 s, citation required); off by default.
GDELT_ENABLED=false

# KNF register (backend/src/investwatch/registry): daily live sync, snapshot fallback offline.
REGISTRY_LIVE_SYNC=true
# Fictional demo firms merged into the register (empty = real register only).
REGISTRY_EXTRA_FIRMS=fixtures/firms.json,registry/demo_firms.json
